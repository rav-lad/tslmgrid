@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: MIT
+"""Swiss Grid Anomaly-CoT: weekly Swiss power and weather series with rule-based explanations.
+
+Reads the samples exported by the swissgrid-cot project (``sgcot-export``), which takes them from
+the TimeNet dataset ``aionic/swiss-grid-anomaly-cot`` and adds rolling 7-day train windows. Point
+``SWISSGRID_COT_DIR`` at the folder holding ``train.jsonl``, ``validation.jsonl`` and ``test.jsonl``.
+
+Each sample is one task on one window: the cause of the largest consumption anomaly, the anomalous
+days, or the net import/export balance. The answer is the rationale, which ends with "Answer: ...".
+"""
+
+import json
+import os
+from typing import List, Literal, Tuple
+
+import numpy as np
+
+from opentslm.prompt.text_time_series_prompt import TextTimeSeriesPrompt
+from opentslm.time_series_datasets.QADataset import QADataset
+
+CAUSES = [
+    "none", "public_holiday", "bridge_day", "christmas_newyear", "summer_holidays",
+    "covid_lockdown", "cold_snap", "heatwave", "unexplained",
+]
+
+
+def _read(path: str) -> list:
+    with open(path, encoding="utf-8") as f:
+        return [json.loads(line) for line in f if line.strip()]
+
+
+class SwissGridCoTQADataset(QADataset):
+    def __init__(self, split: Literal["train", "test", "validation"], EOS_TOKEN: str,
+                 format_sample_str: bool = False, time_series_format_function=None):
+        super().__init__(split, EOS_TOKEN, format_sample_str, time_series_format_function)
+
+    def _load_splits(self) -> Tuple[list, list, list]:
+        root = os.environ.get("SWISSGRID_COT_DIR", "data/swissgrid_cot")
+        return tuple(_read(os.path.join(root, f"{s}.jsonl")) for s in ("train", "validation", "test"))
+
+    def _get_answer(self, row) -> str:
+        return row["answer"]
+
+    def _get_pre_prompt(self, row) -> str:
+        return row["pre_prompt"]
+
+    def _get_post_prompt(self, row) -> str:
+        return row["post_prompt"]
+
+    def _get_text_time_series_prompt_list(self, row) -> List[TextTimeSeriesPrompt]:
+        prompts = []
+        for series in row["series"]:
+            values = np.asarray(series["values"], dtype=np.float64)
+            mean = float(values.mean())
+            std = max(float(values.std()), 1e-6)
+            text = (f"The following is the hourly {series['name'].lower()} in {series['unit']}, "
+                    f"it has mean {mean:.1f} and std {std:.1f}:")
+            prompts.append(TextTimeSeriesPrompt(text, ((values - mean) / std).tolist()))
+        return prompts
+
+    def _format_sample(self, row):
+        sample = super()._format_sample(row)
+        sample["id"] = row["id"]
+        return sample
+
+    @staticmethod
+    def get_labels() -> List[str]:
+        return CAUSES
